# Linko Frontend Environment Configuration
# Data Mode: 'local' (runs 100% in-browser with local persistence) or 'api' (delegates to REST API)
VITE_DATA_MODE=local

# Base URL for the future Node.js + Fastify + PostgreSQL API (e.g. http://localhost:8000/api/v1)
VITE_API_BASE_URL=

# Public Custom Short Domain (optional, defaults to window.location.origin)
VITE_PUBLIC_SHORT_DOMAIN=